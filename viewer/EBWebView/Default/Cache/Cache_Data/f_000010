		getPointnum : function(page){
		    return ( this.cover != 1 ) ? Math.floor(page/2) : Math.floor( (page-this.cover)/2 );

		    /*
            if( this.cover != 1 ){
                return  Math.floor(page/2);
		    }else{
                //cover type
                return  Math.floor( (page-this.cover)/2 );
		    }
            */
