					textw += Math.round(text[pos].width * spaceScale);
				}else{
					if(i + 1 == wordlength && pos - 1 >= 0 && y == text[pos].y && text[pos-1].x + text[pos-1].width >= text[pos].x) {
						textw += Math.round(text[pos].width * spaceScale);
