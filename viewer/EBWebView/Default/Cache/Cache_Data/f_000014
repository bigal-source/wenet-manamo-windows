#range-tip { 
    display: none;
	position: absolute;
	width: 50px; 
	text-align: center; 
	color: #000; 
	font: bold 15px/30px Georgia;
	bottom: 130%;
	left: 0;
	margin-left: -1%;
}

#range-tip:after { 
	content: "";
	position: absolute;
	width: 0;
	height: 0;
	border-top: 10px solid #999;
	border-left: 5px solid transparent;
	border-right: 5px solid transparent;
	top: 100%;
	left: 50%;
	margin-left: -5px;
	margin-top: -1px;
}

.rtl #range-tip{
    right: 0;
    left: initial;
    margin-right: -1%;
    margin-left : 0;
}

.rtl #range-tip:after { 
    right: 50%;
}


