                            that.memoListCountView();
				        }
				    );				
				}else{
					memoview.remove();
				}
				
			});
		},
		
		createMemo : function(obj){
			var that = this;
			var _tempElement = document.createElement('div'),
				tranClass = (obj.skinInfo.trans) ? 'memotrans' : 'memonotrans';
			
			_tempElement.innerHTML = this.itemElement.innerHTML;
			var findBoxElem = htmlview.findElement('.memo-view', _tempElement);
			findBoxElem.css({left: obj.x, top : obj.y, width : obj.w, height : obj.h}).attr({'id' : obj.uniqid, 'data-page' : obj.page}).addClass(tranClass +'  '+this.colorClass+obj.skinInfo.color);
			findBoxElem.find('.memo-close, .memo-mini, .memo-text').attr('data-id', obj.uniqid);
			findBoxElem.find('.memo-title').text(obj.title);
			findBoxElem.find('.memo-text').css('font-size', this.memoTextFontsize);
			this.userModeElem.append(findBoxElem);
			
			findBoxElem.data('objInfo', obj);
			setTimeout(function(){
				that.showTextareaElem(obj);
			}, 0);
			
			
			var lookPosData = PARAM.getActualPosByLookPos(obj.x, obj.y,  obj.h, obj.w);	
			obj.w = lookPosData.w;
			obj.h = lookPosData.h;
		
			this.storageData[obj.page].memoList.push(obj);
			h5appview.setStorageData(obj.page);
			
			this.memoListCountView();
		},
		
		loadMemo : function(obj){
			var _tempElement = document.createElement('div'),
				tranClass = (obj.skinInfo.trans) ? 'memotrans' : 'memonotrans';
			
			_tempElement.innerHTML = this.itemElement.innerHTML;
			var findBoxElem = htmlview.findElement('.memo-view', _tempElement);
			
			var actualpos = PARAM.getLookPosByActualPos( obj.x, obj.y, obj.w, obj.h );
			
			actualpos.w = Math.max( actualpos.w, this.memoDefualtSize);
			actualpos.h = Math.max( actualpos.h, this.memoDefualtSize);
			if(PARAM.side.right == obj.page && PARAM.bookInfo.config.single == 0 && PARAM.side.left != 0){
				actualpos.x += PARAM.side.rightstartx; 
			}
			
			_tempElement.innerHTML = this.itemElement.innerHTML;
			var findBoxElem = htmlview.findElement('.memo-view', _tempElement);
			findBoxElem.css({left: obj.x, top : obj.y, width : actualpos.w, height : actualpos.h}).attr({'id' : obj.uniqid, 'data-page' : obj.page}).addClass(tranClass +'  '+this.colorClass+obj.skinInfo.color);
			findBoxElem.find('.memo-close, .memo-mini, .memo-text').attr('data-id', obj.uniqid);
			
			findBoxElem.find('.memo-title').text(obj.title);
			findBoxElem.find('.memo-text').html( obj.text.replace(/\r\n/g,'\n').replace(/\n/g,'<br>') );
			
			this.userModeElem.append(findBoxElem);
			findBoxElem.data('objInfo', obj);
		},
		
		storageDataToBook : function(){
			var that = this;
			this.userModeElem.html('');
			
			$.each(that.storageData[PARAM.currentpage].memoList, function(key, value){
				that.loadMemo(value);
			});
		},
		
		memoListCountView : function( resize ){
			var  that = this;
			
			if( resize ){
				//PARAM.isResizeWork
				if( PARAM.viewMode == 'onepage' ){
					this.storageDataToBook();
				}else this.userModeElem.html('');
				
				if( this.isTextarea ){
					$('.full-textarea-body').css({'visibility':'hidden', 'z-index':-1});
					$('.fullTextarea').val('');
				}
				
				if( this.memomode )
					ADDONS.closeModal();
				return false;
			}
			
			if( PARAM.viewMode == 'twopage' ) {
				this.userModeElem.html('');
				$("#phone-memo-list-body").css("display", "none");
				this.isPhoneMemoList = false;
				return false;
			}
			
			$('.phone-memo-list-count').text(this.storageData[PARAM.currentpage].memoList.length);
			
			if(this.storageData[PARAM.currentpage].memoList.length <= 0) {
				$("#phone-memo-list-body").css("display", "none");
				this.isPhoneMemoList = false;
				return false;
			}else{
				$("#phone-memo-list-body").css("display", "block");
				this.isPhoneMemoList = true;
			}	
			
			if( this.memomode ){
				this.storageDataToBook();
			}		
		}
	};
	
