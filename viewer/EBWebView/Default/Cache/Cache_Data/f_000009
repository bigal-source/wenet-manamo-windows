				var storageLen = that.storageData[PARAM.currentpage].memoList.length;
				
				x = ( storageLen <= 0 ) ? that.createDefaultPosition_x : that.createDefaultPosition_x - (storageLen+1);
				y = ( storageLen <= 0 ) ? that.createDefaultPosition_y : that.createDefaultPosition_y - (storageLen+1);
								
