			});
			
			PARAM.wisebook.on('tap', '.mobile-memo-savebtn, .mobile-memo-closebtn', function(){
				var uniqid = $('.full-textarea-body').attr('data-uniqid');
				
				if(uniqid == '') {
					//uniqid check
					$('.full-textarea-body').css({'visibility':'hidden', 'z-index':-1});
