			PARAM.wisebook.on('tap', '.memo-color-selecter, .memo-trans-selecter, .memo-eraserall-selecter', function(){
				clicked = $(this);
				if( clicked.hasClass('memo-color-selecter') ){
					$('.memo-color-selecter').removeClass('selected');
					$(this).addClass('selected');
					that.nowColor = $(this).data('color');
				}else if( clicked.hasClass('memo-trans-selecter') ){
					if( that.isTrans ){
						clicked.removeClass('selected').find('i').removeClass('icon-view-view_tool_check');
						that.isTrans = false;
					}else{
						clicked.addClass('selected').find('i').addClass('icon-view-view_tool_check');
						that.isTrans = true;
					}
				}else if( clicked.hasClass('memo-eraserall-selecter') ){
