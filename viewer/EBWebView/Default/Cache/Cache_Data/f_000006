html, body{
    margin: 0;
    padding: 0;
}

#viewBody{
    position: absolute;
    height: 100%;
    width: 100%;
    top: 0;
    left: 0;
	margin: 0;
	padding: 0;
	overflow: hidden;
	font-family: Helvetica Neue, Helvetica, Arial, sans-serif;
	
	user-select: none;
	-moz-user-select: none;
	-webkit-user-select: none;
	-ms-user-select: none;
}

*,
*::before,
*::after{
	-webkit-box-sizing: border-box;
	-moz-box-sizing: border-box;
	box-sizing: border-box;
}

a {
	text-decoration: none;
	cursor: pointer;
}
img {
	border:none;
}

ul,ol{
	list-style: none;
	margin: 0;
	padding: 0;
	display: block;
}

i{
	display: block;
}

::-moz-selection{
    background: #00BCCC;
    text-shadow: none;
}

::selection {
    background: #858484;
    text-shadow: none;
    color: #fff;
}

a,
input,
textarea,
select {
	outline: 0;
}

video::-webkit-media-controls-play-button {
    display: none;
}
