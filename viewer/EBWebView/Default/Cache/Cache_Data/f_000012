        getStorageData: function() {
            var result = null;
            var ajaxUrl = '';
            if( 'bookshelfFlag' in viewInfo == true ){
                ajaxUrl = '/apps/storage_data/' + PARAM.bookInfo.author;
            }else{
                ajaxUrl = '/sqlite/';
            }

            $.ajax({
                type: "POST",
                url: ajaxUrl,
                data: {
                    book_id: PARAM.bookInfo.bookid,
                    type: 1
                },
                dataType:"json",
                async: false,
                success : function( data ){
                    console.log(data);
                    result = data;
                },
                error:function(request,status,error){
                    console.log(error);
                }
            });

            return result;
        },
        


        mergeLocalstorageData : function(success,failure){
            //2023-09-28 移行用マージ処理


            //2023-09-29 キーのルールがsqlite版とjStorage版が違う 
            let oldkey = "";
            if( 'bookshelfFlag' in viewInfo == true ){
              //配信
              oldkey  = "v2-bookshelf-" + PARAM.bookInfo.author + '-' + PARAM.bookInfo.bookid;
            }else{
              //制作
              oldkey  = "v2-make-" + PARAM.bookInfo.author + '-' + PARAM.bookInfo.bookid;
            }
            lsdata= $.jStorage.get( oldkey );
            if(!lsdata){
              return;
            }

            
            var ajaxUrl = '';
            if( 'bookshelfFlag' in viewInfo == true ){
                ajaxUrl = '/apps/storage_data/' + PARAM.bookInfo.author;
            }else{
                ajaxUrl = '/sqlite/';
            }

            $.ajax({
                type: "POST",
                url: ajaxUrl,
                data: {
                    book_id: PARAM.bookInfo.bookid,
                    type: 3,
                    data_obj: JSON.stringify(lsdata)
                },
                success : function( data ){
                    console.log(data);
                    //成功したら削除
                    if(data=='1'){
                       $.jStorage.deleteKey( oldkey );
                      if(success){
                        success();
                      }
                    }else{
                      if(failure){
                        failure();
                      }
                    }
                },
                error:function(request,status,error){
                    console.log(error);
                }
            });
        },



