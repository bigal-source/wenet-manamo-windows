            }else{
                ajaxUrl = '/sqlite/';
            }

            //$.jStorage.set( this.key, this.wisebookStorageList );
            $.ajax({
                type: "POST",
                url: ajaxUrl,
                data: {
                    book_id: PARAM.bookInfo.bookid,
                    type: 2,
                    page: page,
                    data_obj: JSON.stringify(this.wisebookStorageList.pages[page])
                },
                success : function( data ){
                  let findit = false;
                  let nextpage = -1;
                  for(let p in h5appview.wisebookStorageList.pages){
                    if(p==page){
                      findit = true;
                    }else if(findit){
                      nextpage = p;
                      break;
                    }
                  };
                  if(nextpage != -1){
                    console.log("chain ", nextpage);
                    h5appview.setStorageDataChain(nextpage);
                    return;
                  }else{
                    alert("全送信完了");
                  }
                    console.log(data);
                },
                error:function(request,status,error){
                    console.log(error);
                }
            });
