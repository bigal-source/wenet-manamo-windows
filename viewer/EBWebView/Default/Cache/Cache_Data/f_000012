        setBoomarkInfo : function(){
            var memoCntArr   = [];
            var canvasCntArr = [];
            var stampCntArr  = [];
            var blindCntArr  = [];
            $.each(this.wisebookStorageList.pages, function(key, valus){
                console.log(key);
                console.log(valus);
                if(valus.memoList.length > 0)   memoCntArr.push(parseInt( key ));
                if(valus.canvasList.length > 0) canvasCntArr.push(parseInt( key ));
                if(valus.stampList.length > 0)  stampCntArr.push(parseInt( key ));
                if(valus.blindList.length > 0)  blindCntArr.push(parseInt( key ));
            });
            
            this.wisebookStorageList.bookmark.memo = memoCntArr;
            this.wisebookStorageList.bookmark.canvas = canvasCntArr;
            this.wisebookStorageList.bookmark.stamp  = stampCntArr;
            this.wisebookStorageList.bookmark.blind  = blindCntArr;
