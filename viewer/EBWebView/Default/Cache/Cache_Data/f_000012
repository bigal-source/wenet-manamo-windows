        updateBookmarkData : function(){
            console.log('updateBookmarkData');
            var sql = '',
                sqlData = [this.appBookid],
                tmpBookmark ={
                    siori   : [],
                    memo    : [],
                    stamp   : [],
                    canvas  : [],
                    picture : [],
                    movie   : [],
                    urllink : [],
                    blind   : []
                };

            this.wisebookStorageList.bookmark = tmpBookmark;

            sql = 'SELECT * FROM viewer WHERE app_book_id=? ORDER BY page ASC';
            h5applib.query(sql, sqlData, function(dbData){
                if( dbData.res.rows.length > 0 ){
                    var rowLength = dbData.res.rows.length;
                    for(var i=0; i<rowLength; i++){
                        var row = dbData.res.rows.item(i);
                        if( row.module == 'listdata' ){
                            var tmpDataObj = JSON.parse( row.dataobj );

                            if(tmpDataObj.memoList.length > 0){
                                h5appview.wisebookStorageList.bookmark.memo.push(row.page);
                            }
                            
                            if(tmpDataObj.canvasList.length > 0){
                                h5appview.wisebookStorageList.bookmark.canvas.push(row.page);
                            }
                       
                            if(tmpDataObj.linkList.length > 0){
                                h5appview.wisebookStorageList.bookmark.urllink.push(row.page);
                            }
                            
                            // if(tmpDataObj.movieList.length > 0){
                            //     h5appview.wisebookStorageList.bookmark.movie.push(row.page);
                            // }
                            
                            if(tmpDataObj.pictureList.length > 0){
                                for(var k = 0; k < tmpDataObj.pictureList.length; k++){
                                    if(h5appview.wisebookStorageList.bookmark.picture.indexOf(row.page) > -1 && h5appview.wisebookStorageList.bookmark.movie.indexOf(row.page) > -1) break;

                                    if(tmpDataObj.pictureList[k].className == 'attach_gallery' && h5appview.wisebookStorageList.bookmark.picture.indexOf(row.page) == -1)
                                        h5appview.wisebookStorageList.bookmark.picture.push(row.page);
                                    else if(tmpDataObj.pictureList[k].className == 'attach_video' && h5appview.wisebookStorageList.bookmark.movie.indexOf(row.page) == -1)
                                        h5appview.wisebookStorageList.bookmark.movie.push(row.page);
                                }
                            }
                            
                            if(tmpDataObj.stampList.length > 0){
                                h5appview.wisebookStorageList.bookmark.stamp.push(row.page);
                            }

                            if(tmpDataObj.blindList.length > 0){
                                h5appview.wisebookStorageList.bookmark.blind.push(row.page);
                            }
                        }else if( row.module == 'siori' ){
                            if(row.dataobj != '')
                                h5appview.wisebookStorageList.bookmark.siori = $.map( row.dataobj.split(','), function(value){ return parseInt(value, 10); });
                        }
                    }
                }
            });
        },

